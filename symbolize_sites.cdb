$$ Frozen at the initial breakpoint — do not g. We only want symbols.
.symfix F:\rbo_fabre_proto\d3d9_sw\symbols-cache
.sympath+ F:\rbo_fabre_proto\d3d9_sw
.reload /f

.echo ===== lm (our modules) =====
lm m ss_ctx
lm m ucrtbase
lm m ntdll
lm m KERNEL32

.echo ===== ln sites =====
