ln ss_ctx+2F54
.echo --- ss_ctx.exe+2FFA (ntdll-family caller) ---
ln ss_ctx+2FFA
.echo --- ss_ctx.exe+124A2 (ucrt family caller) ---
ln ss_ctx+124A2
